# Copy this file to .env and fill in the values. Never commit .env.
DATABRICKS_HOST=your-workspace-hostname-without-https
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
# Development only (personal access token)
DBX_TOKEN=your-personal-access-token
# Service Principal for ci and prod (OAuth)
DBX_CLIENT_ID=service-principal-client-id
DBX_CLIENT_SECRET=service-principal-oauth-secret
